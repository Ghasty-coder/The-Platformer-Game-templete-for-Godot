config_version=5

[admob]

general/android/app_id="ca-app-pub-9696578935991691~1551194237"
general/ios/enabled=false
mediation/meta=true
mediation/unity_ads=true

[application]

config/name="TFP"
run/main_scene="uid://bfa5r3qbobe1o"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0.8039216, 0.7294118, 1)
config/icon="res://icon.svg"

[autoload]

ControllerIcons="*uid://c8b7fflhew3qv"
Ads="*uid://dqmrcoa2d4sc7"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/controller_icons/plugin.cfg")

